APP_URL=http://localhost:3000
# Use the same PostgreSQL database as Parley/Run/Dev. Never use reset or db push
# against a database shared with Parley/Devrel. This migration only adds tables.
DATABASE_URL=
BASE_RPC_URL=https://mainnet.base.org
BASE_TREASURY_ADDRESS=
# Keep false until migrations, the receiving wallet, and owner access are ready.
AUCTIONS_ENABLED=false
# Optional scheduler token. Owner CHECK PAYMENTS & CLOCKS also reconciles manually.
CRON_SECRET=
# Optional: enables QR/deep-link wallet login outside wallet browsers.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Comma-separated owner wallet addresses. Only these signed-in wallets can
# start a 24-hour countdown or manually close an auction. Empty denies access.
AUCTION_ADMIN_WALLETS=

# Base is the live default. Use the dev:anvil launcher for isolated tests.
NEXT_PUBLIC_AUCTION_NETWORK=base
# Enables /preview on a production build only when explicitly requested.
DESIGN_PREVIEW_ENABLED=false
